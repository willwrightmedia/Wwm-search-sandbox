# Local: save as .streamlit/secrets.toml (never commit it).
# Streamlit Community Cloud: paste these lines into your app's Secrets settings instead.

# --- Gemini --------------------------------------------------------------------
GEMINI_API_KEY = "AIza..."
GEMINI_MODEL = "gemini-3.8-flash"        # whichever Gemini model your key supports

# --- Guest tester account (username: guest / password: password) ---------------
GUEST_ENABLED = "true"                   # set to "false" to switch the guest login off

# --- Admin setup ----------------------------------------------------------------
# Any phrase only you know. The landing page asks for it before creating the "admin"
# account, so nobody else who finds the site can claim admin first.
ADMIN_SETUP_CODE = "WWM"

# After you create the admin account (or reset/change its password), the app shows
# two lines like these. Paste them here so the password survives app restarts:
# ADMIN_EMAIL = "you@example.com"
# ADMIN_PASSWORD_HASH = "$2b$12$..."

# --- Email for "Forgot password" -------------------------------------------------
# Example for Gmail: turn on 2-Step Verification, create an App Password at
# myaccount.google.com/apppasswords, and use it as SMTP_PASSWORD.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "your-16-character-app-password"
SMTP_FROM = "Kat Intelligence Engine <you@gmail.com>"
